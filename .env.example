# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Frontend address, used for links in emails
APP_URL=http://localhost:5173

# Supabase — Project Settings → API (local values are printed by `npm run db:start`)
SUPABASE_URL=http://127.0.0.1:54321
# Secret key (service role). Server only. Bypasses row-level security — never send to the browser.
SUPABASE_SECRET_KEY=

# Postgres connection — Supabase → Connect → Session pooler (port 5432). Server only.
DATABASE_URL=

# Email. Leave RESEND_API_KEY empty in development to print emails (with their links) to the console.
RESEND_API_KEY=
EMAIL_FROM=Synqop <onboarding@resend.dev>

# Reminders, digests and the 30-day organisation deletion run every minute inside the API.
# Set to off only if an outside cron calls POST /v1/internal/run-jobs instead.
SCHEDULER=on
# Optional: a long random value that lets an outside cron call POST /v1/internal/run-jobs
# with the header "Authorization: Bearer <CRON_SECRET>". Leave empty to keep that endpoint off.
CRON_SECRET=

# Integration tests: a Postgres superuser connection (tests create and drop their own databases)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
