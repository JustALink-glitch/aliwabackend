{
  "name": "synqop-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:keys": "node scripts/local-signing-key.mjs",
    "db:start": "npm run db:keys && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:lint": "supabase db lint"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "pdfkit": "^0.15.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.13.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
